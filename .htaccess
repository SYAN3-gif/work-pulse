# Laragon / Apache SPA Routing for WorkPulse Root Folder
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # If dist directory exists and request hits root, option to route to dist:
  # RewriteCond %{REQUEST_URI} !^/dist/
  # RewriteCond %{DOCUMENT_ROOT}/dist -d
  # RewriteRule ^(.*)$ /dist/$1 [L]

  # Direct asset and file serving
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
</IfModule>
